{
  "auto_install_extensions": {
    "flexoki-themes": true,
    "latex": true
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "disable_ai": true,
  "terminal": {
    "font_weight": 300.0,
    "font_size": 14.0
  },
  "buffer_font_weight": 200.0,
  "buffer_font_family": "JetBrains Mono",
  "ui_font_size": 16,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "system",
    "light": "Flexoki Light",
    "dark": "Flexoki Dark"
  },
  "format_on_save": "off",
  "languages": {
    "Python": {
      "language_servers": [
        "basedpyright",
        "ruff",
        "!ty",
        "!pyright",
        "!pylsp",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    },
    "LaTeX": {
      "soft_wrap": "editor_width"
    }
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "typeCheckingMode": "standard"
        }
      }
    },
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "latexmk",
            "args": [
              "-pdf",
              "-interaction=nonstopmode",
              "-synctex=1",
              "%f"
            ],
            "onSave": true,
            "forwardSearchAfter": true
          },
          "forwardSearch": {
            "executable": "zathura",
            "args": [
              "--synctex-forward",
              "%l:1:%f",
              "%p"
            ]
          }
        }
      }
    }
  }
}
