default-timeout=2000
text-color=#CECDC3
font=JetBrainsMono Nerd Font 11
# progress bar (volume popup) one step above the notification background
progress-color=over #575653

# same 6px gap as Hyprland's gaps_out
margin=6
padding=10
border-size=2

# raised above the #100F0F windows so notifications stand out; urgency shows in the border colour
[urgency=low]
background-color=#1C1B1A
border-color=#878580
default-timeout=1500

[urgency=normal]
background-color=#282726
border-color=#CECDC3
default-timeout=2500

[urgency=high]
background-color=#282726
border-color=#DA702C
default-timeout=0
